# Copy to .env for local development. Never commit the real .env.
# In Docker these come from `-e` flags or an env file; on AWS they come from
# the task definition, the user data script, or SSM Parameter Store.

APP_ENV=local
APP_LOG_LEVEL=INFO

# Model
APP_MODEL_FILE=yolov8n.pt
APP_DEVICE=cpu
APP_IMGSZ=640
APP_CONF_THRESHOLD=0.25
APP_IOU_THRESHOLD=0.45
APP_WARMUP=true

# Limits
APP_MAX_BATCH_SIZE=16
APP_MAX_UPLOAD_BYTES=10485760

# Runtime
APP_TORCH_THREADS=2
APP_INFERENCE_CONCURRENCY=2
APP_JOB_TTL_SECONDS=900

# Teaching only. Leave false everywhere else.
APP_ENABLE_DEMO_ROUTES=false
