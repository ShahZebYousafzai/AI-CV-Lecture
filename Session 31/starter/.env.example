# Copy this file to .env and fill in your key.  Never commit .env.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cheapest current OpenAI chat model. Swap for gpt-5.6-terra / gpt-5.6-sol if you want more quality.
MODEL_NAME=gpt-5.6-luna

# Reasoning budget: none | low | medium | high
# "none" = fastest + cheapest, which is what we want for a live demo.
REASONING_EFFORT=none
